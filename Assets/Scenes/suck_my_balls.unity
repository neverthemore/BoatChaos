    - target: {fileID: 1779835006572481041, guid: 7242f5029a2031b41a0b6694c1b05e39, type: 3}
      propertyPath: m_text
      value: "\r<align=center><color=#FF0000><b><size=120%> \u0412\u0420\u0410\u0416\u0415\u0421\u041A\u0418\u0419
        \u041A\u041E\u0420\u0410\u0411\u041B\u042C \u041F\u041E \u041F\u0420\u0410\u0412\u041E\u041C\u0423
        \u0411\u041E\u0420\u0422\u0423!</size></b></color></align>\r\n\r\n<color=#8B4513><i><indent=10%>\u0427\u0435\u0440\u0442\u0438
        \u043F\u043E\u043B\u043E\u0441\u0430\u0442\u044B\u0435!  </i>\r\n<indent=12%><b><color=#CD5C5C>\u0415\u0441\u043B\u0438
        \u043D\u0435 \u043F\u043E\u0442\u043E\u043F\u0438\u0448\u044C - \u043D\u0430\u0448
        \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u0431\u0443\u0434\u0435\u0442
        \u043A\u0430\u043A \u0440\u0435\u0448\u0435\u0442\u043E!</b></color></indent></color>\r\n\r\n<color=#DAA520><indent=5%>
        <b><size=110%>\u042F\u0414\u0420\u0410</size></b> \u0432 \u0442\u0440\u044E\u043C\u0435
        \u0437\u0432\u0435\u043D\u044F\u0442, <b>\u041F\u0423\u0428\u041A\u0418</b>
        \u0436\u0430\u0436\u0434\u0443\u0442 \u043C\u0435\u0441\u0442\u0438 - </color>\r\n<color=#B8860B><indent=7%>\u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u044C\u0441\u044F,
        <b>\u0441\u043E\u0431\u0430\u043A\u0430 \u043F\u0430\u043B\u0443\u0431\u043D\u0430\u044F</b>,
        \u0434\u0430 \u0434\u0430\u0439 \u0438\u043C \u043E\u0433\u043D\u044F!</indent></color>\r\n\n<align=center><size=75%><color=#2F4F4F><i>[E]
        \u0412\u0417\u042F\u0422\u042C \u0417\u0410\u0420\u042F\u0414 | \u0417\u0410\u041B\u041E\u0416\u0418\u0422\u042C
        \u0412 \u0416\u0415\u0420\u041B\u041E | \u041E\u0422\u041F\u0420\u0410\u0412\u0418\u0422\u042C
        \u041A \u0427\u0415\u0420\u0422\u042F\u041C</i></color></size></align>"
      objectReference: {fileID: 0}
