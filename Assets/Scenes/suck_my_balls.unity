--- !u!114 &9005241561687323317
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 579210040650953209}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0523dbcbf49abe44cb647c19be81ded4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  targetScript: {fileID: 1470650040}
  dialogueText: {fileID: 2584524227927068329}
  dialoguePanel: {fileID: 197911310430010627}
  continueIcon: {fileID: 6185376866880192707}
  dialogueLines:
  - "-\u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F
    \u043E\u0442 \u043F\u043E\u0445\u043C\u0435\u043B\u044C\u044F! \u041C\u044B \u043F\u043E\u043F\u0430\u043B\u0438
    \u0432 \u0431\u0435\u0440\u043C\u0443\u0434\u0441\u043A\u0438\u0439 \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A,
    \u043F\u043E\u043A\u0430 \u043F\u043B\u044B\u043B\u0438 \u0432 \u041D\u0430\u0441\u0441\u0430\u0443,
    \u0438\u0437-\u0437\u0430 \u044D\u0442\u043E\u0433\u043E \u0443 \u043D\u0430\u0441
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u043A\u0430\u043A\u043E\u0439
    \u0442\u043E \u043A\u0430\u0432\u0430\u0440\u0434\u0430\u043A. \u0414\u0430\u0432\u0430\u0439
    \u044F \u0431\u044B\u0441\u0442\u0440\u043E\_ \u0432\u0432\u0435\u0434\u0443
    \u0442\u0435\u0431\u044F \u0432 \u043A\u0443\u0440\u0441 \u0434\u0435\u043B\u0430!"
  - "-\u0421\u043B\u0443\u0448\u0430\u0439 \u0441\u044E\u0434\u0430, \u0441\u0430\u043B\u0430\u0433\u0430!
    \u0423 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u0447\u0435\u0442\u044B\u0440\u0435
    \u0440\u0443\u043A\u0438, \u0432\u0435\u0440\u043D\u0435\u0435, \u0447\u0435\u0442\u044B\u0440\u0435
    \u0433\u043E\u043B\u043E\u0432\u044B:"
  - "1. \u041A\u0430\u043F\u0438\u0442\u0430\u043D \u2014 \u0442\u044B! \u0420\u0443\u043B\u044C,
    \u043F\u0430\u0440\u0443\u0441\u0430, \u043A\u0440\u0438\u043A\u0438 \xAB\u041F\u043E\u043B\u0443\u043D\u0434\u0440\u0430!\xBB.
    \u041A\u043D\u043E\u043F\u043A\u0438? \u0414\u0430 \u0445\u043E\u0442\u044C \u043D\u043E\u0441\u043E\u043C
    \u0442\u044B\u043A\u0430\u0439, \u043B\u0438\u0448\u044C \u0431\u044B \u043D\u0435
    \u0441\u0435\u043B\u0438 \u043D\u0430 \u043C\u0435\u043B\u044C!"
  - "2. \u041C\u0435\u0445\u0430\u043D\u0438\u043A \u2014 \u043D\u0430\u0448 \u0447\u0443\u043C\u0430\u0437\u044B\u0439
    \u0433\u0435\u043D\u0438\u0439. \u0415\u0433\u043E \u043C\u043E\u043B\u043E\u0442\u043E\u043A
    \u0447\u0438\u043D\u0438\u0442 \u0434\u044B\u0440\u044B \u0431\u044B\u0441\u0442\u0440\u0435\u0435,
    \u0447\u0435\u043C \u0442\u044B \u043E\u043F\u0443\u0441\u0442\u043E\u0448\u0430\u0435\u0448\u044C
    \u0440\u043E\u043C!\_"
  - "3. \u0414\u043E\u043A\u0442\u043E\u0440 \u2014 \u0431\u043E\u0440\u043E\u0434\u0430\u0442\u044B\u0439
    \u0446\u0435\u043B\u0438\u0442\u0435\u043B\u044C. \u0411\u0435\u0437 \u043D\u0435\u0433\u043E
    \u043C\u0430\u0442\u0440\u043E\u0441\u044B \u0437\u0430\u0433\u043D\u0443\u0442\u0441\u044F
    \u043E\u0442 \u0447\u0438\u0445\u0430, \u0430 \u0442\u044B \u2014 \u043E\u0442
    \u0438\u0445 \u0432\u043E\u043D\u0438!"
  - "4. \u041F\u0443\u0448\u043A\u0430\u0440\u044C \u2014 \u0433\u0440\u043E\u043C\u043E\u0432\u0435\u0440\u0436\u0435\u0446!
    \u0415\u0433\u043E \u044F\u0434\u0440\u0430\u043C \u0437\u0430\u0432\u0438\u0434\u0443\u044E\u0442
    \u0441\u0430\u043C\u0438 \u043A\u0440\u0430\u043A\u0435\u043D\u044B. \u041D\u0435
    \u0434\u0430\u0439 \u043F\u0438\u0440\u0430\u0442\u0430\u043C \u043E\u0431\u0433\u043B\u043E\u0434\u0430\u0442\u044C
    \u043D\u0430\u0448 \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u0434\u043E \u043A\u043E\u0441\u0442\u0435\u0439!"
  - "\u2014 \u0414\u043E \u0440\u0430\u0439\u0441\u043A\u043E\u0433\u043E \u041D\u0430\u0441\u0441\u0430\u0443
    \u2014 12 \u043C\u0438\u043D\u0443\u0442! \u041D\u043E \u044D\u0442\u043E \u0435\u0441\u043B\u0438
    \u0442\u044B \u043D\u0435 \u0443\u0442\u043E\u043F\u0438\u0448\u044C \u043D\u0430\u0441
    \u0440\u0430\u043D\u044C\u0448\u0435! \u0421\u043C\u043E\u0442\u0440\u0438:"
  - "-\u041D\u0430 \u0442\u0432\u043E\u0451\u043C \u043F\u0443\u0442\u0438 \u0442\u0435\u0431\u0435
    \u0432\u0441\u0442\u0440\u0435\u0442\u044F\u0442\u0441\u044F \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B, \u0442\u0430\u043A\u0438\u0435
    \u043A\u0430\u043A \u0434\u0440\u0443\u0433\u0438\u0435 \u043F\u0438\u0440\u0430\u0442\u044B,
    \u043F\u043E\u043B\u043E\u043C\u043A\u0438, \u0431\u043E\u043B\u0435\u0437\u043D\u0438
    \u0438 \u0442\u0430\u043A \u0434\u0430\u043B\u0435\u0435.\_"
  - "- \u0421 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C
    \u0432\u0441\u0435\u0433\u043E \u044D\u043A\u0438\u043F\u0430\u0436\u0430 \u043A\u043E\u0440\u0430\u0431\u043B\u044F,
    \u0443\u0441\u0442\u0440\u0430\u043D\u044F\u0439 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0441\u0442\u0438
    \u0438 \u0434\u043E\u0432\u0435\u0434\u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u0443
    \u0434\u043E \u043A\u043E\u043D\u0446\u0430!"
  - "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435: WASD - \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435,
    Q - \u043A\u043E\u043B\u0435\u0441\u043E \u0441\u043C\u0435\u043D\u044B \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u0439,
    E/\u041B\u041A\u041C - \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435,
    , ESC - \u043C\u0435\u043D\u044E(\u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C
    \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C))"
  - "\u0423\u0434\u0430\u0447\u0438!"
  startOnAwake: 1
  typeSound: {fileID: 8300000, guid: c34fd347ac2649544ab0f712fdc621f7, type: 3}
  pitchVariation: 0.114
  charsPerSecond: 25
  continueKey: 32
  SkipKey: 308
  canDial: 1
